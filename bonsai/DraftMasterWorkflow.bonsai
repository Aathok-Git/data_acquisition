        <Property Name="PortVoltage" DisplayName="Miniscope PortVoltage" Category="Ucla Miniscope V4" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:ConfigureUclaMiniscopeV4">
          <onix1:Name>UclaMiniscopeV4</onix1:Name>
          <onix1:Camera>
            <onix1:DeviceName>UclaMiniscopeV4/UclaMiniscopeV4</onix1:DeviceName>
            <onix1:DeviceAddress>512</onix1:DeviceAddress>
            <onix1:Enable>true</onix1:Enable>
            <onix1:FrameRate>Fps30</onix1:FrameRate>
            <onix1:SensorGain>Medium</onix1:SensorGain>
            <onix1:InterleaveLed>false</onix1:InterleaveLed>
            <onix1:LedBrightness>98.8</onix1:LedBrightness>
            <onix1:Focus>0</onix1:Focus>
          </onix1:Camera>
          <onix1:Bno055>
            <onix1:DeviceName>UclaMiniscopeV4/PolledBno055</onix1:DeviceName>
            <onix1:DeviceAddress>513</onix1:DeviceAddress>
            <onix1:Enable>true</onix1:Enable>
            <onix1:AxisMap>ZYX</onix1:AxisMap>
            <onix1:AxisSign>MirrorZ</onix1:AxisSign>
          </onix1:Bno055>
          <onix1:Port>PortB</onix1:Port>
          <onix1:PortVoltage>
            <onix1:Requested xsi:nil="true" />
          </onix1:PortVoltage>
        </Combinator>
      </Expression>
      <Expression xsi:type="gui:SliderBuilder">
        <gui:Name>Focus</gui:Name>
        <gui:Enabled>true</gui:Enabled>
        <gui:Visible>true</gui:Visible>
