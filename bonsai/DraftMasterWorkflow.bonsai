        <gui:Minimum>-100</gui:Minimum>
        <gui:Maximum>100</gui:Maximum>
        <gui:DecimalPlaces>0</gui:DecimalPlaces>
        <gui:Value>-12</gui:Value>
      </Expression>
      <Expression xsi:type="PropertyMapping">
        <PropertyMappings>
          <Property Name="Focus" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="gui:SliderBuilder">
        <gui:Name>LED Brightness</gui:Name>
        <gui:Enabled>true</gui:Enabled>
        <gui:Visible>true</gui:Visible>
        <gui:Font>Microsoft Sans Serif, 8.25pt</gui:Font>
        <gui:Minimum>0</gui:Minimum>
        <gui:Maximum>100</gui:Maximum>
        <gui:DecimalPlaces>0</gui:DecimalPlaces>
        <gui:Value>50</gui:Value>
      </Expression>
      <Expression xsi:type="PropertyMapping">
        <PropertyMappings>
          <Property Name="LedBrightness" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="gui:ComboBoxBuilder">
        <gui:Name>Gain</gui:Name>
        <gui:Enabled>true</gui:Enabled>
        <gui:Visible>true</gui:Visible>
        <gui:Font>Microsoft Sans Serif, 8.25pt</gui:Font>
        <gui:Items>
          <gui:string>Low</gui:string>
          <gui:string>Medium</gui:string>
          <gui:string>High</gui:string>
        </gui:Items>
        <gui:SelectedItem>Medium</gui:SelectedItem>
      </Expression>
      <Expression xsi:type="scr:ExpressionTransform">
        <scr:Name>ConvertType</scr:Name>
        <scr:Description>Converts the output of the Gain ComboBox to an integer that ConfigureUclaMiniscopeV4Camera can parse.</scr:Description>
        <scr:Expression>it == "Low" ? 225 :
it == "Medium" ? 228 :
it == "High" ? 36 :
225
</scr:Expression>
      </Expression>
      <Expression xsi:type="PropertyMapping">
        <PropertyMappings>
          <Property Name="SensorGain" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="gui:ComboBoxBuilder">
        <gui:Name>FPS</gui:Name>
        <gui:Enabled>true</gui:Enabled>
        <gui:Visible>true</gui:Visible>
        <gui:Font>Microsoft Sans Serif, 8.25pt</gui:Font>
        <gui:Items>
          <gui:string>FPS30</gui:string>
          <gui:string>FPS25</gui:string>
          <gui:string>FPS20</gui:string>
          <gui:string>FPS15</gui:string>
          <gui:string>FPS10</gui:string>
        </gui:Items>
        <gui:SelectedItem />
      </Expression>
      <Expression xsi:type="scr:ExpressionTransform">
        <scr:Name>ConvertType</scr:Name>
        <scr:Expression>it == "FPS30" ? 4 :
it == "FPS25" ? 3 :
it == "FPS20" ? 2 :
it == "FPS15" ? 1 :
it == "FPS10" ? 0 :
4
</scr:Expression>
      </Expression>
      <Expression xsi:type="PropertyMapping">
        <PropertyMappings>
          <Property Name="FrameRate" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="onix1:ConfigureUclaMiniscopeV4Camera">
            <onix1:DeviceName />
            <onix1:DeviceAddress>512</onix1:DeviceAddress>
            <onix1:Enable>true</onix1:Enable>
            <onix1:FrameRate>Fps30</onix1:FrameRate>
            <onix1:SensorGain>Medium</onix1:SensorGain>
            <onix1:InterleaveLed>false</onix1:InterleaveLed>
            <onix1:LedBrightness>50</onix1:LedBrightness>
            <onix1:Focus>-12</onix1:Focus>
          </Combinator>
        </Builder>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:StartAcquisition">
